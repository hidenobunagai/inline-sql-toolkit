# Exclude everything except dist/cli.js, dist/package.json, and distribution documents
src/**
test/**
tools/**
docs/**
reports/**
syntaxes/**
third_party/**
dist/extension.js
# dist/package.json MUST ship: it marks dist/ as CommonJS. The root package.json
# says "type": "module", so without this file Node treats dist/cli.js as ESM and
# the published CLI dies with "module is not defined in ES module scope".
dist-test/**
dist-vsix/**
coverage/**
.venv/**
node_modules/**
.git/**
.github/**
.vscode/**
.vscode-test/**
.superpowers/**
.claude/**
.codebuddy/**
.cursor/**
.gemini/**
.kiro/**
.qoder/**
.worktrees/**
.headroom/**
.code-review-graph/**
*.png
*.svg
*.html
*.toml
*.mjs
*.lock
*.log
*.ts
*.map
*.vsix
package.nls*.json
tsconfig.json
.prettier*
.pre-commit*
.vscodeignore
.npmignore
.gitignore
.gitattributes
.mcp.json
opencode.jsonc
CLAUDE.md
CODEBUDDY.md
GEMINI.md
QODER.md
AGENTS.md
