# Keep the packaged runtime roots explicitly (vsce uses negated patterns).
!dist/extension.js
!python/bootstrap.py
!python/inline_sql_helper/*.py
!python/vendor/sqlparse/**/*.py
!python/vendor/sqlparse/**/py.typed
!syntaxes/**
