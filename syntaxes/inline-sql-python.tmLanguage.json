{
  "name": "Inline SQL Python Injection",
  "scopeName": "inline-sql.python.injection",
  "injectionSelector": "L:source.python -comment -string, L:source.mo-python -comment -string",
  "patterns": [
    {
      "include": "#leadingNewlineTripleDoubleSql"
    },
    {
      "include": "#leadingNewlineTripleSingleSql"
    },
    {
      "include": "#leadingNewlineDoubleSql"
    },
    {
      "include": "#leadingNewlineSingleSql"
    },
    {
      "include": "#fTripleDoubleSql"
    },
    {
      "include": "#fTripleSingleSql"
    },
    {
      "include": "#fDoubleSql"
    },
    {
      "include": "#fSingleSql"
    },
    {
      "include": "#plainTripleDoubleSql"
    },
    {
      "include": "#plainTripleSingleSql"
    },
    {
      "include": "#plainDoubleSql"
    },
    {
      "include": "#plainSingleSql"
    }
  ],
  "repository": {
    "leadingNewlineTripleDoubleSql": {
      "begin": "(?ix)(?:^[ \\t]*|[=(:,\\[\\{][ \\t]*|\\b(?:return|yield|assert)[ \\t]+)(?:f|fr|rf|r)?\\\"\\\"\\\"(?=[ \\t]*$)",
      "end": "\\\"\\\"\\\"",
      "patterns": [
        {
          "include": "#sqlAfterLeadingNewlineTripleDouble"
        }
      ]
    },
    "leadingNewlineTripleSingleSql": {
      "begin": "(?ix)(?:^[ \\t]*|[=(:,\\[\\{][ \\t]*|\\b(?:return|yield|assert)[ \\t]+)(?:f|fr|rf|r)?'''(?=[ \\t]*$)",
      "end": "'''",
      "patterns": [
        {
          "include": "#sqlAfterLeadingNewlineTripleSingle"
        }
      ]
    },
    "leadingNewlineDoubleSql": {
      "begin": "(?ix)(?:^[ \\t]*|[=(:,\\[\\{][ \\t]*|\\b(?:return|yield|assert)[ \\t]+)(?:f|fr|rf|r)?\\\"(?!\\\"\\\")(?=[ \\t]*$)",
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\\"",
      "patterns": [
        {
          "include": "#sqlAfterLeadingNewlineDouble"
        }
      ]
    },
    "leadingNewlineSingleSql": {
      "begin": "(?ix)(?:^[ \\t]*|[=(:,\\[\\{][ \\t]*|\\b(?:return|yield|assert)[ \\t]+)(?:f|fr|rf|r)?'(?!'')(?=[ \\t]*$)",
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K'",
      "patterns": [
        {
          "include": "#sqlAfterLeadingNewlineSingle"
        }
      ]
    },
    "sqlAfterLeadingNewlineTripleDouble": {
      "begin": "(?ix)^(?=[ \\t]*(?:(?:--(?:sql|[ ]sql)[ \\t]*$)|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?=\\\"\\\"\\\")",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "sqlAfterLeadingNewlineTripleSingle": {
      "begin": "(?ix)^(?=[ \\t]*(?:(?:--(?:sql|[ ]sql)[ \\t]*$)|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?=''')",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "sqlAfterLeadingNewlineDouble": {
      "begin": "(?ix)^(?=[ \\t]*(?:(?:--(?:sql|[ ]sql)[ \\t]*$)|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?=\\\")",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "sqlAfterLeadingNewlineSingle": {
      "begin": "(?ix)^(?=[ \\t]*(?:(?:--(?:sql|[ ]sql)[ \\t]*$)|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?=')",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "plainTripleDoubleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])r?\\\"\\\"\\\"(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=\\\"\\\"\\\")))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "\\\"\\\"\\\"",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "plainTripleSingleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])r?'''(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=''')))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "'''",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "plainDoubleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])r?\\\"(?!\\\"\\\")(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=\\\")))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\\"",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "plainSingleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])r?'(?!'')(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=')))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K'",
      "contentName": "meta.embedded.inline.sql source.sql",
      "patterns": [
        {
          "include": "source.sql"
        }
      ]
    },
    "fTripleDoubleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])(?:f|fr|rf)\\\"\\\"\\\"(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=\\\"\\\"\\\")))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "\\\"\\\"\\\"",
      "patterns": [
        {
          "include": "inline-sql.fstring-islands.injection"
        },
        {
          "include": "#sqlCaptureBeforeTripleDouble"
        }
      ]
    },
    "fTripleSingleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])(?:f|fr|rf)'''(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=''')))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "'''",
      "patterns": [
        {
          "include": "inline-sql.fstring-islands.injection"
        },
        {
          "include": "#sqlCaptureBeforeTripleSingle"
        }
      ]
    },
    "fDoubleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])(?:f|fr|rf)\\\"(?!\\\"\\\")(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=\\\")))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K\\\"",
      "patterns": [
        {
          "include": "inline-sql.fstring-islands.injection"
        },
        {
          "include": "#sqlCaptureBeforeDouble"
        }
      ]
    },
    "fSingleSql": {
      "begin": "(?ix)(?<![[:alnum:]_])(?:f|fr|rf)'(?!'')(?=[ \\t\\r\\n]*(?:(?:--(?:sql|[ ]sql)[ \\t]*(?:\\r\\n|\\r|\\n|(?=')))|(?:(?:select|with|insert|update|delete|merge|create|alter|drop|truncate|explain)\\b)))",
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K'",
      "patterns": [
        {
          "include": "inline-sql.fstring-islands.injection"
        },
        {
          "include": "#sqlCaptureBeforeSingle"
        }
      ]
    },
    "sqlCaptureBeforeTripleDouble": {
      "match": "(?:(?!\\\"\\\"\\\"|\\{(?!\\{))(?:\\{\\{|\\}\\}|[\\s\\S]))+",
      "captures": {
        "0": {
          "name": "meta.embedded.inline.sql source.sql",
          "patterns": [
            {
              "include": "source.sql"
            }
          ]
        }
      }
    },
    "sqlCaptureBeforeTripleSingle": {
      "match": "(?:(?!'''|\\{(?!\\{))(?:\\{\\{|\\}\\}|[\\s\\S]))+",
      "captures": {
        "0": {
          "name": "meta.embedded.inline.sql source.sql",
          "patterns": [
            {
              "include": "source.sql"
            }
          ]
        }
      }
    },
    "sqlCaptureBeforeDouble": {
      "match": "(?:\\{\\{|\\}\\}|(?!(?:\\\\\\\\)+\\\")\\\\[^{}]|(?!\\\"|\\{(?!\\{)|\\\\)[\\s\\S])+",
      "captures": {
        "0": {
          "name": "meta.embedded.inline.sql source.sql",
          "patterns": [
            {
              "include": "source.sql"
            }
          ]
        }
      }
    },
    "sqlCaptureBeforeSingle": {
      "match": "(?:\\{\\{|\\}\\}|(?!(?:\\\\\\\\)+')\\\\[^{}]|(?!'|\\{(?!\\{)|\\\\)[\\s\\S])+",
      "captures": {
        "0": {
          "name": "meta.embedded.inline.sql source.sql",
          "patterns": [
            {
              "include": "source.sql"
            }
          ]
        }
      }
    }
  }
}
